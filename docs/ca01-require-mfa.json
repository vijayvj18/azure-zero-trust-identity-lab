{
  "name": "CA01 - Require MFA for standard users",
  "state": "enabled",
  "conditions": {
    "users": {
      "includeGroups": [
        "grp-zero-trust-standard-users"
      ]
    },
    "applications": {
      "includeApplications": [ "All cloud apps" ]
    }
  },
  "grantControls": {
    "operator": "AND",
    "builtInControls": [ "mfa" ]
  }
}
